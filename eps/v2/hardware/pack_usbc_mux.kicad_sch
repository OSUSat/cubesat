	(text "When the MCU enters standby mode, if the EN pin is held low by driving\nthe N channel MOSFET's gate without using the padkeeping functionality,\nthe held state will be released and the load may be turned on mistakenly.\nThe pad keeping functionality can be used to mitigate this."
		(exclude_from_sim no)
		(at 86.868 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3148bcbb-b000-43c3-8645-45785f69e13c")
	)
	(text "3.8A trip current with headroom\n\nFound using these assumptions:\n\n- RPi CM4 + Global Shutter Camera = 1.5A typ.\n- OBC = 0.2A typ.\n- ADCS = 0.4A worst case\n- Comms = 0.5A worst case"
		(exclude_from_sim no)
		(at 230.378 125.476 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "31ef3126-cca7-4512-922a-ce9cfe38cff9")
	)
