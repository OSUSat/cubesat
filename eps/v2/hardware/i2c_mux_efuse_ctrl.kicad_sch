	(text "MCU high turns the FET on, which pulls the rail eFuse EN/UVLO low and turns the rail off.\nEach rail's EN/UVLO divider is on the power rail eFuse sheet (#176)."
		(exclude_from_sim no)
		(at 297.18 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "72a2cc44-609e-4037-9c6d-ba765aa5350a")
	)

	(text "The MCU pins float during reset, so the 100k on each gate sets the boot state:\npull-down = rail on, pull-up to +3V3 = rail off."
		(exclude_from_sim no)
		(at 297.18 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "74d8320e-60e0-4741-b9b6-daa620bd4864")
	)

