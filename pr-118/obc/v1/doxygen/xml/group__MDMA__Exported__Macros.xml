      <memberdef kind="define" id="group__MDMA__Exported__Macros_1gaaf946c0dd2867f0dc7fd2148a0d9a3d5" prot="public" static="no">
        <name>__HAL_MDMA_GET_FLAG</name>
        <param><defname>__HANDLE__</defname></param>
        <param><defname>__FLAG__</defname></param>
        <initializer>((__HANDLE__)-&gt;Instance-&gt;CISR &amp; (__FLAG__))</initializer>
        <briefdescription>
<para>Get the MDMA Channel pending flags. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>__HANDLE__</parametername>
</parameternamelist>
<parameterdescription>
<para>MDMA handle </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>__FLAG__</parametername>
</parameternamelist>
<parameterdescription>
<para>Get the specified flag. This parameter can be any combination of the following values: <itemizedlist>
<listitem><para>MDMA_FLAG_TE : Transfer Error flag. </para>
</listitem>
<listitem><para>MDMA_FLAG_CTC : Channel Transfer Complete flag. </para>
</listitem>
<listitem><para>MDMA_FLAG_BRT : Block Repeat Transfer flag. </para>
</listitem>
<listitem><para>MDMA_FLAG_BT : Block Transfer complete flag. </para>
</listitem>
<listitem><para>MDMA_FLAG_BFTC : BuFfer Transfer Complete flag. </para>
</listitem>
<listitem><para>MDMA_FLAG_CRQA : Channel request Active flag. </para>
</listitem>
</itemizedlist>
</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>The</parametername>
</parameternamelist>
<parameterdescription>
<para>state of FLAG (SET or RESET). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
