        <name>__HAL_FLASH_CALC_BOOT_BASE_ADR</name>
        <param><defname>__ADDRESS__</defname></param>
        <initializer>((__ADDRESS__) &gt;&gt; 14U)</initializer>
        <briefdescription>
<para>Calculate the FLASH Boot Base Address (BOOT_ADD0 or BOOT_ADD1) </para>
        </briefdescription>
        <detaileddescription>
<para><simplesect kind="note"><para>Returned value BOOT_ADDx[15:0] corresponds to boot address [29:14]. </para>
</simplesect>
