<parameternamelist>
<parametername>__ADDRESS__</parametername>
</parameternamelist>
<parameterdescription>
<para>FLASH Boot Address (in the range 0x0000 0000 to 0x2004 FFFF with a granularity of 16KB) </para>
</parameterdescription>
</parameteritem>
